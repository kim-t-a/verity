# Environment variable NAMES for Verity — placeholder values only.
#
# Copy this file to `.env` and fill in real values there. `.env` is
# git-ignored (guaranteed, not just commented — see
# backend/tests/test_secrets_are_ignored.py), so real values never reach
# git. A key pasted into a chat, a commit or a screenshot is a leaked key
# and must be rotated.
#
# Never put a real API key in this file: it IS committed. Keep values out.

# The model provider (NVIDIA build.nvidia.com). The backend proxy keeps
# this key server-side; the frontend must never see it.
NVIDIA_API_KEY=

# Base URL of the OpenAI-compatible generation/embedding endpoint, set
# during Phase 0 verification. Kept configurable so the provider can be
# swapped without code changes.
NVIDIA_API_BASE_URL=

# Which chat model decides answers. The publicly listed catalog is larger
# than what a given account can invoke -- verified per model before serving.
NVIDIA_LLM_MODEL=

# Backend selection for tests / offline demos: "nvidia" (default) or "fake".
# The fake embedding provider returns all-zero vectors, which can never score
# under cosine similarity, so a fake-built index degrades to keyword-only
# retrieval rather than producing plausible-looking wrong matches.
VERITY_LLM_PROVIDER=
VERITY_EMBEDDING_PROVIDER=

# Database connection. The default host is 127.0.0.1, not "localhost": on
# Windows, psycopg2 first resolves "localhost" as IPv6 and pays the full TCP
# fallback timeout (~21 s) on every connection.
VERITY_DB_HOST=
VERITY_DB_PORT=
VERITY_DB_NAME=
VERITY_DB_USER=
VERITY_DB_PASSWORD=

# Where uploaded files are stored before ingestion.
VERITY_UPLOAD_DIR=
